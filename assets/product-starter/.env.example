# Explicit offline SDK tool-loop validation; no model or account calls.
TANSR_MODE=offline
PORT=4317
# Optional absolute data directory; default is .data in this product directory.
# DATA_DIR=
# This file is a template. Copy it to .env in this product's backend directory.
# For normal setup, fill the two values in a local editor rather than chat.
# To use the platform, change the existing TANSR_MODE above to platform.
# Do not add a second TANSR_MODE assignment. Blank credentials are not ready.
TANSR_APP_ID=
TANSR_APP_KEY=
TANSR_API_BASE_URL=https://api.tansr.com
