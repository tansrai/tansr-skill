# Platform application credentials remain on this backend. Empty values permit local startup.
TANSR_APP_KEY_ID=
TANSR_APP_KEY=
TANSR_API_BASE=https://api.tansr.com

DEMO_HOST=127.0.0.1
DEMO_PORT=8788
DEMO_LOGIN_HOST=127.0.0.1
DEMO_LOGIN_PORT=8787
# npm run configure creates these local secrets if empty; it never prints them.
DEMO_AUTH_SECRET=
DEMO_LOGIN_USER=demo
DEMO_LOGIN_PASSWORD=
DEMO_END_USER=u-alice
DEMO_SERVE_ONLY=1
DEMO_STORE_DIR=.serve-demo-store
