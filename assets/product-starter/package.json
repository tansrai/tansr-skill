{
  "name": "tansr-local-product-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs"
  },
  "dependencies": {
    "@tansr/sdk": "0.18.1",
    "@tansr/serve": "0.15.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
